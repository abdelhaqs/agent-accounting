# Uniblock API key for DeBank ingestion & on-chain JSON-RPC verification
# Get your key from https://app.uniblock.dev/
UNIBLOCK_API_KEY=your_uniblock_api_key_here
# Optional: backup Uniblock API key if primary key runs out of compute units or hits rate limits
UNIBLOCK_API_KEY_BACKUP=your_backup_uniblock_api_key_here

# EVM wallet address to track (only used if agents.yaml is missing)
WALLET_ADDRESS=0x42b9df65b219b3dd36ff330a4dd8f327a6ada990

# Optional: path to agents config file (default: config/agents.yaml)
AGENTS_CONFIG=config/agents.yaml

# Optional: comma-separated chain ids (e.g. base,ethereum). Leave blank for all chains.
CHAIN_IDS=base

