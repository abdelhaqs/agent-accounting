project_id = "your-gcp-project"
region     = "us-central1"

# Container image must already exist in Artifact Registry.
sync_image = "us-central1-docker.pkg.dev/your-gcp-project/agent-accounting/agent-accounting-sync:latest"

# Paste your Uniblock API key here. It will be stored in Secret Manager.
uniblock_api_key = "YOUR_UNIBLOCK_API_KEY"

# Optional: only sync Base chain data.
sync_env = {
  CHAIN_IDS = "base"
}

# Optional: mount agents.yaml from a separate GCS config bucket.
# cloud_run_volumes = [{
#   name = "agents-config"
#   gcs = {
#     bucket    = "agent-accounting-config-bucket"
#     read_only = true
#   }
# }]
# cloud_run_volume_mounts = [{
#   name       = "agents-config"
#   mount_path = "/app/config/agents.yaml"
# }]
